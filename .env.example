# IG Group API
IG_API_KEY=your_api_key_here
IG_USERNAME=your_username_here
IG_PASSWORD=your_password_here
IG_ACC_TYPE=DEMO
IG_ACC_ID=your_account_id_here

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Trading config
TRADING_MODE=PAPER
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.05
MAX_OPEN_POSITIONS=3
SIGNAL_THRESHOLD=0.65
LLM_CONFIDENCE_THRESHOLD=0.70

# Instruments to trade (IG epics)
INSTRUMENTS=IX.D.FTSE.DAILY.IP,CS.D.GBPUSD.TODAY.IP,CS.D.GOLD.TODAY.IP
